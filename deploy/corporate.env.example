# Copy to deploy/corporate.env. This file is gitignored.
# Internal infrastructure names are intentionally not committed to the repo.

DOCKER_REGISTRY_MIRROR="https://docker-mirror.example.internal"

# Colon-separated CA certificate files. PEM and DER X.509 are both accepted.
CORPORATE_CA_FILES="/path/to/root-ca.crt:/path/to/intermediate-ca.cer"

PIP_INDEX_URL="http://pypi-mirror.example.internal/simple"
PIP_TRUSTED_HOST="pypi-mirror.example.internal"

# python:3.12-slim is Debian-based. Use Debian mirrors, not host Ubuntu suites.
APT_DEBIAN_MIRROR_URL="http://debian-mirror.example.internal/debian"
APT_DEBIAN_SECURITY_MIRROR_URL="http://debian-mirror.example.internal/debian-security"
